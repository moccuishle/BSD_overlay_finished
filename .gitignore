!bsd45/kernel/fs/nfs/config.mk

bsd45/kernel/driver/dev/**
!bsd45/kernel/driver/dev/**/
!bsd45/kernel/driver/dev/**/config.mk
!bsd45/kernel/driver/dev/config.mk

