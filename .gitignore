# build products / extracted source (regenerated by build_kernel.ps1)
bsd45/build/
bsd45/src/
bsd45/out/
*.o

# local reference trees / archives, not part of the project
reno/
reno-src-main.zip

# scratch
*.ppm
*.log
.tmp/

# VMware runtime files
bsd45/vms/*.scoreboard
bsd45/vms/*.vmsd
bsd45/vms/*.vmxf
bsd45/vms/nvram
bsd45/vms/*.lck/
bsd45/vms/*.log
bsd45/vms/*.vmem
bsd45/vms/*.vmsn
bsd45/vms/*.vmss
bsd45/vms/*.vmdk

# ---------------------------------------------------------------------------
# 4.4BSD-Lite2 tree, merged into kernel/ but not tracked: regenerated from
# the tarball by tools/ensure-src.ps1 + tools/reorganize.ps1.  Only the files
# are ignored (not the directories themselves), so every per-directory
# config.mk stays in git and the tree skeleton is visible in the repository.
# ---------------------------------------------------------------------------
bsd45/kernel/include/sys/**
!bsd45/kernel/include/sys/**/
!bsd45/kernel/include/sys/**/config.mk
!bsd45/kernel/include/sys/config.mk

bsd45/kernel/include/machine/**
!bsd45/kernel/include/machine/**/
!bsd45/kernel/include/machine/**/config.mk
!bsd45/kernel/include/machine/config.mk

bsd45/kernel/include/lib/**
!bsd45/kernel/include/lib/**/
!bsd45/kernel/include/lib/**/config.mk
!bsd45/kernel/include/lib/config.mk

bsd45/kernel/arch/**
!bsd45/kernel/arch/**/
!bsd45/kernel/arch/**/config.mk
!bsd45/kernel/arch/config.mk
# the three patched 4.4BSD files stay tracked
!bsd45/kernel/arch/i386/isa/locore.s
!bsd45/kernel/arch/i386/isa/machdep.c
!bsd45/kernel/arch/i386/isa/pmap.c

bsd45/kernel/vm/**
!bsd45/kernel/vm/**/
!bsd45/kernel/vm/**/config.mk
!bsd45/kernel/vm/config.mk

bsd45/kernel/net/**
!bsd45/kernel/net/**/
!bsd45/kernel/net/**/config.mk
!bsd45/kernel/net/config.mk

